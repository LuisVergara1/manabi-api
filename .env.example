# Copy to .env, fill locally, and use scripts/start-dev.ps1 explicitly. Never commit .env.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Optional pair: omit BOTH to keep first-admin bootstrap disabled.
MANABI_ADMIN_USERNAME=
MANABI_ADMIN_PASSWORD=
# Optional locally: blank is omitted by start-dev.ps1, using the dedicated home default.
MANABI_PUBLICATION_ROOT=
SPRING_PROFILES_ACTIVE=dev
# Comma-separated exact origins. No wildcard. HTTP only localhost in dev.
MANABI_ADMIN_ALLOWED_ORIGINS=
# Blank uses the active profile's safe default; production must use true.
MANABI_SESSION_COOKIE_SECURE=
MANABI_SESSION_SAME_SITE=lax
MANABI_SESSION_TIMEOUT=20m
MANABI_FORWARD_HEADERS_STRATEGY=NONE
MANABI_API_DOCS_ENABLED=false
MANABI_BIND_ADDRESS=127.0.0.1

# Optional in dev; mandatory separate pair in prod. Configure credentials out of band.
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=
MANABI_EXPORT_MAX_BYTES=134217728
